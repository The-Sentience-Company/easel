<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <!-- The launcher resolves node at launch; baking an nvm path here would
       strand the agent on a version switch or prune. -->
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/install/easeld-launcher.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>EASEL_PORT</key>
    <string>__PORT__</string>
    <key>EASEL_DATA_DIR</key>
    <string>__STATE__</string>
    <key>PATH</key>
    <string>__PATH__</string>
__NODE_ENV__
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>__STATE__/daemon.log</string>
  <key>StandardErrorPath</key>
  <string>__STATE__/daemon.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
